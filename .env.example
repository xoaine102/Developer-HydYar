# Copy to .env and fill values. NEVER commit .env.
DATABASE_URL=postgresql://user:password@localhost:5432/hydyar?schema=public
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
# Sandbox / execution limits
EXEC_MAX_CPU_MS=8000
EXEC_MAX_MEM_MB=256
EXEC_MAX_OUTPUT_KB=64
EXEC_QUEUE_MAX=20
EXEC_CONCURRENCY=2
# CORS / frontend origin
WEB_ORIGIN=http://localhost:5173
PORT=4000
# Admin bootstrap (optional; first registered user becomes admin if set)
BOOTSTRAP_ADMIN_EMAIL=
